Linux ethtool ioctl buffers intentionally append storage to flexible headers.
Retain the existing ABI layout and permit the implemented GNU extension in Clang.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -6,6 +6,9 @@
 check_c_compiler_flag(-Wimplicit-fallthrough HAS_IMPLICIT_FALLTHROUGH)
 
 ADD_DEFINITIONS(-Wall -Werror)
+IF(CMAKE_C_COMPILER_ID MATCHES "Clang")
+  ADD_DEFINITIONS(-Wno-gnu-variable-sized-type-not-at-end)
+ENDIF()
 IF(CMAKE_C_COMPILER_VERSION VERSION_GREATER 6)
 	add_definitions(-Wextra -Werror=implicit-function-declaration)
 	add_definitions(-Wformat -Werror=format-security -Werror=format-nonliteral)
