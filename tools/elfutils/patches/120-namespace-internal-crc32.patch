 	    } while (mmap (mapped, mapsize, PROT_READ, MAP_FIXED|MAP_PRIVATE,
@@ -83,7 +83,7 @@
 					     off))) > 0)
     {
       off += count;
-      crc = crc32 (crc, buffer, count);
+      crc = __libeu_crc32 (crc, buffer, count);
     }
 
