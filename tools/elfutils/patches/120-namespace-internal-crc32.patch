Give elfutils' internal CRC32 routine a private name to avoid exporting a
generic symbol that collides with the libc++abi runtime.

--- a/lib/libeu.h
+++ b/lib/libeu.h
@@ -42,7 +42,7 @@
 extern char *xasprintf(const char *fmt, ...)
 	__attribute__ ((format (printf, 1, 2))) __attribute__ ((__malloc__));
 
-extern uint32_t crc32 (uint32_t crc, unsigned char *buf, size_t len);
+extern uint32_t __libeu_crc32 (uint32_t crc, unsigned char *buf, size_t len);
 extern int crc32_file (int fd, uint32_t *resp);
 
 #endif
--- a/lib/crc32.c
+++ b/lib/crc32.c
@@ -91,7 +91,7 @@
 };
 
