 		{
-		  *resp = crc32 (crc, mapped, st.st_size);
+		  *resp = __libeu_crc32 (crc, mapped, st.st_size);
 		  munmap (mapped, mapsize);
 		  return 0;
 		}
-	      crc = crc32 (crc, mapped, mapsize);
+	      crc = __libeu_crc32 (crc, mapped, mapsize);
